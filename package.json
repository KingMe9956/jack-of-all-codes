    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "helmet": "^7.1.0",
    "validator": "^13.11.0",
    "winston": "^3.11.0",
    "speakeasy": "^2.0.0",
