{
  "name": "jack-ai-agent",
  "version": "2.0.0",
  "description": "Jack of All Codes - Hardened AI Development Agent with Enterprise Security",
  "main": "jack-v2-hardened.js",
  "scripts": {
    "start": "node jack-v2-hardened.js",
    "dev": "NODE_ENV=development node jack-v2-hardened.js",
    "docker:build": "docker build -t jack-ai-agent:latest .",
    "docker:run": "docker run -d --name jack -v /var/run/docker.sock:/var/run/docker.sock -e CF_API_TOKEN=${CF_API_TOKEN} -e GITHUB_TOKEN=${GITHUB_TOKEN} jack-ai-agent:latest",
    "deploy": "wrangler deploy",
    "test": "jest --coverage",
    "security:scan": "npm audit && snyk test",
    "security:update": "npm audit fix && npm update",
    "logs": "docker logs -f jack",
    "stop": "docker stop jack && docker rm jack"
  },
  "keywords": [
    "ai",
    "agent",
    "automation",
    "deployment",
    "cloudflare",
    "github",
    "security",
    "devops",
