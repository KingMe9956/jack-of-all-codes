#!/bin/bash
# JACK INSTALLATION SCRIPT
# For Ubuntu/Linux/Termux

echo "🤖 Installing JACK - Jack of All Codes"
echo "========================================"

# Update system
echo "📦 Updating system packages..."
sudo apt-get update -y

# Install Node.js (if not installed)
if ! command -v node &> /dev/null; then
    echo "📥 Installing Node.js..."
    curl -fsSL https://deb.nodesource.com/setup_18.x | sudo -E bash -
    sudo apt-get install -y nodejs
fi

# Install Git (if not installed)
if ! command -v git &> /dev/null; then
    echo "📥 Installing Git..."
    sudo apt-get install -y git
fi

# Create Jack directory
echo "📁 Creating Jack directory..."
mkdir -p ~/jack-agent
cd ~/jack-agent

# Initialize npm project
echo "📦 Initializing project..."
npm init -y

# Install dependencies
echo "📥 Installing dependencies..."
npm install @octokit/rest axios dotenv

# Install Cloudflare Wrangler
echo "☁️ Installing Cloudflare Wrangler..."
npm install -g wrangler

# Install voice recognition (optional - for full voice control)
echo "🎤 Installing voice recognition tools..."
sudo apt-get install -y espeak festival portaudio19-dev python3-pyaudio

# Create .env file
echo "⚙️ Creating configuration file..."
cat > .env << 'EOF'
# JACK CONFIGURATION
# Replace these with your actual values

# Cloudflare
CF_API_TOKEN=your_ api_here
CF_ACCOUNT_ID=your_account_id_here
CF_ZONE_ID=your_zone_id_here

# GitHub (Create token at: github.com/settings/tokens)
GITHUB_TOKEN=your_github_token_here
GITHUB_USERNAME=your_github_username

# Coinbase Commerce
COINBASE_API_KEY=7e471aa9-ea53-42ad-b375-be7ed1275f45
COINBASE_WEBHOOK_SECRET=your_webhook_secret

# Supabase (if using)
SUPABASE_URL=your_supabase_url
SUPABASE_KEY=your_supabase_key

# Security
ALLOWED_IP=158.51.117.86
DEVICE_NAME=Samsung Tablet 9
EOF

echo "✅ .env file created!"
echo ""
echo "⚠️  IMPORTANT: Edit the .env file with your actual credentials:"
echo "   nano .env"
echo ""

# Create wrangler.toml for Cloudflare Workers
cat > wrangler.toml << 'EOF'
name = "jack-agent-worker"
main = "src/worker.js"
compatibility_date = "2024-01-01"
account_id = "" # Add your Cloudflare account ID

[env.production]
name = "jack-agent-prod"
workers_dev = false
route = "yourdomain.com/*"

[[d1_databases]]
binding = "DB"
database_name = "jack-projects-db"
database_id = "" # Will be created during setup

[[kv_namespaces]]
binding = "JACK_KV"
id = "" # Will be created during setup
EOF

echo "✅ Wrangler config created!"

# Create package.json scripts
echo "📝 Adding npm scripts..."
npm pkg set scripts.start="node jack-of-all-codes.js"
npm pkg set scripts.deploy="wrangler deploy"
npm pkg set scripts.dev="node jack-of-all-codes.js"

# Create systemd service (optional - for auto-start)
echo "🔧 Creating systemd service..."
sudo cat > /etc/systemd/system/jack-of-all-codes-ai-agent.service << EOF
[Unit]
Description=Jack Expert AI Dev Agent
After=network.target

[Service]
Type=simple
User=$USER
WorkingDirectory=$HOME/jack-agent
ExecStart=/usr/bin/node $HOME/jack-agent/jack-agent.js
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
EOF

echo "✅ Systemd service created!"
echo ""
echo "🎯 NEXT STEPS:"
echo "1. Edit .env file:              nano .env"
echo "2. Get your GitHub token:       https://github.com/settings/tokens"
echo "3. Get Cloudflare Account ID:   https://dash.cloudflare.com"
echo "4. Save jack-agent.js file:     (The main Jack code)"
echo "5. Start Jack:                  npm start"
echo ""
echo "🔧 OPTIONAL - Enable auto-start:"
echo "   sudo systemctl enable jack-agent"
echo "   sudo systemctl start jack-agent"
echo ""
echo "🎤 VOICE SETUP (For hands-free operation):"
echo "   We'll set this up after basic testing"
echo ""
echo "✅ Installation complete!"
echo "🤖 Ready to activate JACK!"
echo "✅ Installation complete!"
echo "🤖 Ready to activate JACK!"
