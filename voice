#!/usr/bin/env python3
"""
JACK VOICE ACTIVATION MODULE
Enables hands-free voice control for LocalDAO
Wake word: "Jack"
End transmission: "Over"
Terminate: "Over and out"
"""

import speech_recognition as sr
import pyttsx3
import subprocess
import json
import requests
from threading import Thread
import time

class JackVoiceController:
    def __init__(self):
        self.recognizer = sr.Recognizer()
        self.microphone = sr.Microphone()
        self.tts_engine = pyttsx3.init()
        self.is_listening = True
        self.conversation_active = False
        self.wake_word = "jack"
        self.end_word = "over"
        self.terminate_word = "over and out"
        
        # Configure TTS voice
        self.tts_engine.setProperty('rate', 150)  # Speed
        self.tts_engine.setProperty('volume', 1.0)  # Volume
        
        print("🎤 JACK Voice Controller initialized")
    
    def speak(self, text):
        """Text-to-speech output"""
        print(f"🗣️ JACK: {text}")
        self.tts_engine.say(text)
        self.tts_engine.runAndWait()
    
    def listen(self):
        """Listen for voice input"""
        with self.microphone as source:
            # Adjust for ambient noise
            self.recognizer.adjust_for_ambient_noise(source, duration=0.5)
            
            try:
                audio = self.recognizer.listen(source, timeout=5, phrase_time_limit=10)
                # Use Google Speech Recognition (free tier)
                text = self.recognizer.recognize_google(audio)
                return text.lower()
            except sr.WaitTimeoutError:
                return None
            except sr.UnknownValueError:
                return None
            except sr.RequestError as e:
                print(f"❌ Speech recognition error: {e}")
                return None
    
    def send_command_to_jack(self, command):
        """Send voice command to main Jack agent"""
        try:
            # Call the Node.js Jack agent via stdin or API
            result = subprocess.run(
                ['node', '/home/jack-agent/jack-agent.js', '--command', command],
                capture_output=True,
                text=True,
                timeout=30
            )
            return result.stdout
        except subprocess.TimeoutExpired:
            return "Command timed out"
        except Exception as e:
            return f"Error: {str(e)}"
    
    def process_command(self, transcript):
        """Process voice commands"""
        if not transcript:
            return
        
        print(f"👂 Heard: {transcript}")
        
        # Wake word detection
        if self.wake_word in transcript and not self.conversation_active:
            self.conversation_active = True
            self.speak("Jack here. What do you need?")
            return
        
        # Terminate conversation
        if self.terminate_word in transcript:
            self.speak("Over and out. Standing by.")
            self.conversation_active = False
            return
        
        # End of transmission
        if self.end_word in transcript and self.conversation_active:
            self.speak("Over. Listening.")
            return
        
        # Process active conversation commands
        if self.conversation_active:
            # Send to main Jack agent
            response = self.send_command_to_jack(transcript)
            # Jack will speak his own response
            print(f"📡 Jack response: {response}")
    
    def run(self):
        """Main listening loop"""
        self.speak("Jack voice controller active. Say Jack to wake me up.")
        
        while self.is_listening:
            try:
                transcript = self.listen()
                if transcript:
                    self.process_command(transcript)
                
                # Small delay to prevent excessive CPU usage
                time.sleep(0.1)
                
            except KeyboardInterrupt:
                print("\n🛑 Shutting down voice controller...")
                self.speak("Voice controller shutting down. Goodbye.")
                break
            except Exception as e:
                print(f"❌ Error: {e}")
                time.sleep(1)

